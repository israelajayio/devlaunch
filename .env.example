# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is never committed to version control and is never sent to the
# frontend — it's read only by app.py on the server.

# ---- Required ---------------------------------------------------------

# Your Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Optional (sensible defaults are used if omitted) ------------------

# Which Gemini model to use for generation. Any model that supports
# structured outputs (response_schema) will work. Check
# https://ai.google.dev/gemini-api/docs/models for the current recommended
# model if this default has since been deprecated.
GEMINI_MODEL=gemini-3.6-flash

# Per-request timeout (seconds) for calls to Gemini.
GEMINI_TIMEOUT_SECONDS=30

# Comma-separated list of frontend origins allowed to call this API.
# Use "*" only for local development — restrict this in production.
# Example: CORS_ORIGINS=https://devlaunch.app,https://www.devlaunch.app
CORS_ORIGINS=*

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port the Flask dev server listens on.
PORT=5000

# "production" disables Flask's debug mode/reloader.
# Set to "development" for local auto-reload + tracebacks.
FLASK_ENV=production
