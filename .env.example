# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is never committed to version control and is never sent to the
# frontend — it's read only by app.py on the server.

# ---- Required ---------------------------------------------------------

# Your OpenAI API key. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ---- Optional (sensible defaults are used if omitted) ------------------

# Which OpenAI model to use for generation. Any model that supports the
# Responses API + structured outputs will work. Check
# https://platform.openai.com/docs/models for the current recommended
# model if this default has since been deprecated.
OPENAI_MODEL=gpt-5-mini

# Per-request timeout (seconds) for calls to OpenAI.
OPENAI_TIMEOUT_SECONDS=30

# Comma-separated list of frontend origins allowed to call this API.
# Use "*" only for local development — restrict this in production.
# Example: CORS_ORIGINS=https://devlaunch.app,https://www.devlaunch.app
CORS_ORIGINS=*

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Port the Flask dev server listens on.
PORT=5000

# "production" disables Flask's debug mode/reloader.
# Set to "development" for local auto-reload + tracebacks.
FLASK_ENV=production
